@{
    ViewData["Title"] = "Inicio";
}

<style>
    body {
        background-color: #0f0f0f;
        color: white;
    }

    .hero {
        background: linear-gradient(rgba(0,0,0,.75), rgba(0,0,0,.85)), url('/img/studio.jpg');
        background-size: cover;
        background-position: center;
        padding: 100px 20px;
        border-radius: 20px;
    }

        /* Título principal en Rojo */
        .hero h1 {
            font-size: 55px;
            font-weight: bold;
            color: #dc3545;
        }

    .service-card {
        background: #181818;
        border: none;
        border-radius: 20px;
        padding: 30px;
        height: 100%;
        transition: .3s;
    }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(42,82,152,.3);
        }

    .service-icon {
        font-size: 45px;
        color: #2a5298;
    }

    .price {
        color: #2a5298;
        font-size: 22px;
        font-weight: bold;
    }

    .music-box {
        background: #181818;
        border-radius: 20px;
        padding: 30px;
    }

    audio {
        filter: invert(1);
    }

    .btn-zone {
        background: #2a5298;
        color: white;
        font-weight: bold;
        padding: 12px 30px;
        border-radius: 50px;
        border: none;
        box-shadow: 0 4px 12px rgba(42, 82, 152, 0.3);
        transition: all 0.25s ease;
        display: inline-block;
        text-decoration: none;
    }

        .btn-zone:hover {
            background: #1e3c72;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(30, 60, 114, 0.4);
        }
</style>

<div class="container mt-5">

    <!-- INICIO -->
    <section class="hero text-center mb-5">

        <h1>Zone Style Studio</h1>

        <p class="lead">
            Producción musical profesional,
            grabación, mezcla y masterización.
        </p>

        <div class="mt-3">

            @if (Context.Session.GetString("Rol") == null)
            {
                <a href="/Usuario/Registro" class="btn btn-zone mt-3">
                    Reserva tu sesión
                </a>
            }
            else
            {
                <a href="/Reserva/Listar" class="btn btn-zone mt-3">
                    Realizar Reserva
                </a>
            }

        </div>

        <!-- CONTACTO WHATSAPP -->
        <div class="mt-4">

            <p class="mb-2">
                ¿Tienes dudas o necesitas más información?
                Comunícate con uno de nuestros asesores.
            </p>

            <a href="https://wa.me/51910454864?text=Hola%20Zone%20Style%20Studio,%20quiero%20información%20sobre%20sus%20servicios"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-success">

                <i class="bi bi-whatsapp"></i>
                Contactar con un asesor

            </a>

        </div>

    </section>

    <!-- SERVICIOS -->
    <section class="mb-5">

        <h2 class="text-center mb-4">
            Nuestros Servicios
        </h2>

        <div class="row g-4">

            @if (ViewBag.Servicios != null)
            {
                foreach (var servicio in ViewBag.Servicios)
                {
                    <div class="col-md-4">

                        <div class="service-card text-center">

                            <div class="service-icon"></div>

                            <h4 class="mt-3">
                                @servicio.Nombre
                            </h4>

                            <p>
                                Servicio profesional de Zone Style Studio
                                para artistas, cantantes y proyectos musicales.
                            </p>

                            <div class="price mb-3">
                                S/ @servicio.Precio.ToString("0.00")
                            </div>

                            @if (Context.Session.GetString("Rol") == null)
                            {
                                <a href="/Usuario/Registro" class="btn btn-zone">
                                    📅 Reservar Servicio
                                </a>
                            }
                            else
                            {
                                <a href="/Reserva/Nuevo?idServicio=@servicio.IdServicio"
                                   class="btn btn-zone">
                                    📅 Reservar Servicio
                                </a>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    No hay servicios disponibles.
                </div>
            }

        </div>

    </section>

    <!-- CATÁLOGO MUSICAL -->
    <section class="mt-5 mb-5">

        <h2 class="text-center mb-4">
            Catálogo Musical
        </h2>

        <div class="music-box">

            <h5>Escucha nuestros trabajos</h5>

            <hr />

            <!-- CANCIÓN 1 -->
            <audio controls class="w-100 mb-3">
                <source src="~/canciones/Cancion 1.mp3" type="audio/mpeg" />
                Tu navegador no admite la reproducción de audio.
            </audio>

            <!-- CANCIÓN 2 -->
            <audio controls class="w-100 mb-3">
                <source src="~/canciones/Cancion 2.mp3" type="audio/mpeg" />
                Tu navegador no admite la reproducción de audio.
            </audio>

            <!-- CANCIÓN 3 -->
            <audio controls class="w-100 mb-3">
                <source src="~/canciones/Cancion 4.mp3" type="audio/mpeg" />
                Tu navegador no admite la reproducción de audio.
            </audio>

            <!-- SPOTIFY -->
            <div class="mt-4 text-center">

                <p class="mb-2">
                    Escucha nuestras producciones musicales,
                    lanzamientos y proyectos en nuestro perfil oficial de Spotify.
                </p>

                <a href="https://open.spotify.com/intl-es/artist/7tDqxbNdSmjSXjbKlhttOE?si=oe0pl1QmRPOKtqCIphbV_g"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-success">

                    <i class="bi bi-spotify"></i>
                    Escuchar en Spotify

                </a>

            </div>

        </div>

    </section>

    <!-- INSTRUMENTALES -->
    <section class="mt-5 mb-5">

        <h2 class="text-center mb-4">
            Pistas / Instrumentales en Venta
        </h2>

        <div class="music-box">

            <h5>
                Compra instrumentales profesionales
            </h5>

            <hr />

            <!-- INSTRUMENTAL 1 -->
            <div class="row align-items-center mb-4">

                <div class="col-md-8">

                    <h5>Instrumental 1</h5>

                    <audio controls class="w-100">
                        <source src="~/instrumentales/Instrumental 1.mp3"
                                type="audio/mpeg" />
                        Tu navegador no admite la reproducción de audio.
                    </audio>

                </div>

                <div class="col-md-4 text-center">

                    <h5 class="price">
                        S/ 100.00
                    </h5>

                    <a href="/Pago/Nuevo?idServicio=4"
                       class="btn btn-zone">
                        Comprar
                    </a>

                </div>

            </div>

            <!-- INSTRUMENTAL 2 -->
            <div class="row align-items-center mb-4">

                <div class="col-md-8">

                    <h5>Instrumental 2</h5>

                    <audio controls class="w-100">
                        <source src="~/instrumentales/Instrumental 2.mp3"
                                type="audio/mpeg" />
                        Tu navegador no admite la reproducción de audio.
                    </audio>

                </div>

                <div class="col-md-4 text-center">

                    <h5 class="price">
                        S/ 100.00
                    </h5>

                    <a href="/Pago/Nuevo?idServicio=4"
                       class="btn btn-zone">
                        Comprar
                    </a>

                </div>

            </div>

            <!-- INSTRUMENTAL 3 -->
            <div class="row align-items-center mb-4">

                <div class="col-md-8">

                    <h5>Instrumental 3</h5>

                    <audio controls class="w-100">
                        <source src="~/instrumentales/Instrumental 3.mp3"
                                type="audio/mpeg" />
                        Tu navegador no admite la reproducción de audio.
                    </audio>

                </div>

                <div class="col-md-4 text-center">

                    <h5 class="price">
                        S/ 100.00
                    </h5>

                    <a href="/Pago/Nuevo?idServicio=4"
                       class="btn btn-zone">
                        Comprar
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- VIDEOS REALIZADOS -->
    <section class="text-center mt-5 mb-5">

        <h2 class="mb-3">
            Videos realizados
        </h2>

        <p class="mb-3">
            Conoce los videos musicales y proyectos audiovisuales
            realizados por Zone Style Studio.
        </p>

        <a href="https://www.youtube.com/watch?v=4tGmsly06pk"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-zone">

            <i class="bi bi-play-circle"></i>
            Ver videos realizados

        </a>

    </section>

</div>

<!-- REPRODUCIR UNA SOLA CANCIÓN O INSTRUMENTAL A LA VEZ -->
<script>
    const reproductores = document.querySelectorAll("audio");

    reproductores.forEach(audio => {
        audio.addEventListener("play", function () {

            reproductores.forEach(otroAudio => {
                if (otroAudio !== audio) {
                    otroAudio.pause();
                    otroAudio.currentTime = 0;
                }
            });

        });
    });
</script>
