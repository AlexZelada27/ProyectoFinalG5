@model List<ProyectoFinalG5.Models.Cliente>

<style>
    /* Título "Zone Style" en Rojo Oficial */
    .titulo {
        color: #dc3545;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    /* Tarjeta contenedora limpia */
    .card-clientes {
        background: #ffffff;
        border: 1px solid #d0dbe7;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 18, 56, 0.25);
        padding: 25px;
    }

    /* Cabecera de la tabla en Negro Elegante */
    .table thead th {
        background: #121212 !important;
        color: white;
        text-align: center;
        padding: 15px;
        border: none;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
        color: #2b2b2b;
    }

    /* Efecto hover suave en tono celeste/azul tenue */
    .table tbody tr:hover {
        background: #eef4fc;
        transition: .3s;
    }

    /* Botón Eliminar en Cápsula */
    .btn-eliminar {
        background: #dc3545;
        color: white;
        font-weight: bold;
        border-radius: 50px;
        padding: 7px 18px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .btn-eliminar:hover {
            background: #bb2d3b;
            color: white;
            transform: translateY(-1px);
        }

    .header-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
</style>
<div class="container mt-4">

    <div class="header-panel">
        <h2 class="titulo">
            👥 Lista de Clientes
        </h2>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center shadow rounded-pill">
            @TempData["Error"]
        </div>
    }

    <div class="card card-clientes">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Nombre</strong>
                        </td>

                        <td>
                            📞 @item.Telefono
                        </td>

                        <td>
                            <a class="btn-eliminar" href="/Cliente/Eliminar/@item.IdCliente"
                               onclick="return confirm('¿Deseas eliminar este cliente?');">
                                🗑 Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>