@model ProyectoFinalG5.Models.Cliente

<h2 class="mb-4">Editar Cliente</h2>

<div class="card shadow p-4">

    <form method="post">

        <input type="hidden" name="IdCliente" value="@Model.IdCliente" />

        <div class="mb-3">
            <label class="form-label">Nombres</label>
            <input class="form-control" name="Nombres" value="@Model.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input class="form-control" name="Telefono" value="@Model.Telefono" />
        </div>

        <button type="submit" class="btn btn-primary">
            Actualizar
        </button>

        <a href="/Cliente/Listar" class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>