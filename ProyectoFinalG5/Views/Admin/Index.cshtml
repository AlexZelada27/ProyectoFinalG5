@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Panel Admin - Zone Style</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                margin: 0;
                min-height: 100vh;
                overflow-x: hidden;
                /* Fondo Degradado Azul Intenso a Azul Noche */
                background: linear-gradient(180deg, #0052d4 0%, #0040b0 45%, #002878 75%, #001238 100%);
                background-attachment: fixed;
                color: #ffffff;
            }

            /* CONTENEDOR */

            .container {
                text-align: center;
                padding: 40px 20px;
            }

            h1 {
                color: #ffffff;
                font-size: 40px;
                margin-bottom: 5px;
                letter-spacing: 1px;
                font-weight: 800;
            }

            /* Subtítulo sobre fondo azul */
            h3 {
                color: #e0e7ff;
                margin-bottom: 40px;
                font-weight: 700;
            }

            /* PANEL */

            .panel {
                max-width: 1200px;
                margin: auto;
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 25px;
            }

            /* TARJETAS */

            .card {
                width: 220px;
                min-height: 130px;
                background: #ffffff;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #d0dbe7;
                box-shadow: 0 10px 25px rgba(0, 18, 56, 0.25);
                transition: transform 0.25s ease, background-color 0.25s ease, border-color 0.25s ease;
            }

                .card:hover {
                    transform: translateY(-5px);
                    background-color: #f8fafc;
                    border-color: #0ea5e9;
                    box-shadow: 0 15px 30px rgba(14, 165, 233, 0.35);
                }

            /* BOTONES CELESTES */

            .btn-panel {
                display: block;
                width: 88%;
                padding: 12px 10px;
                background: #0ea5e9;
                color: white;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 700;
                font-size: 0.95rem;
                box-shadow: 0 4px 12px rgba(14, 165, 233, 0.35);
                transition: all 0.25s ease;
            }

                .btn-panel:hover {
                    background: #0284c7;
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 16px rgba(2, 132, 199, 0.45);
                }

            /* CERRAR SESIÓN */

            .logout {
                display: inline-block;
                margin-top: 40px;
                padding: 12px 35px;
                background: #dc3545;
                color: white;
                border-radius: 50px;
                text-decoration: none;
                font-weight: 700;
                box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
                transition: all 0.25s ease;
            }

                .logout:hover {
                    background: #bb2d3b;
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 16px rgba(187, 45, 59, 0.4);
                }

            /* DISEÑO RESPONSIVE */

            @@media (max-width: 576px) {
                .container {
                    padding: 30px 15px;
                }

                h1 {
                    font-size: 28px;
                }

                h3 {
                    margin-bottom: 25px;
                }

                .panel {
                    gap: 15px;
                }

                .card {
                    width: 100%;
                    max-width: 320px;
                    min-height: 100px;
                }
            }
    </style>
</head>
<body>

    <div class="container">

        <h1>🎧 Panel de Administración</h1>

        <h3>Zone Style Studio</h3>

        <div class="panel">

            <div class="card">
                <a class="btn-panel" href="/Cliente/Listar">
                    Clientes
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Empleado/Listar">
                    Empleados
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Servicio/Listar">
                    Servicios
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/TipoServicio/Listar">
                    Tipos de servicio
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/HorarioFijo/Listar">
                    Horarios
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Reserva/Listar">
                    Reservas
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Pago/Listar">
                    Pagos
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/SalaEstudio/Listar">
                    Salas
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Usuario/Listar">
                    Usuarios
                </a>
            </div>

            <div class="card">
                <a class="btn-panel" href="/Rol/Listar">
                    Roles
                </a>
            </div>

        </div>

        <a href="/Usuario/Logout" class="logout">
            Cerrar sesión
        </a>

    </div>

</body>
</html>
