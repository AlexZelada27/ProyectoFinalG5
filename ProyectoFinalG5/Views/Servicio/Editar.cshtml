@model ProyectoFinalG5.Models.Servicio

@{
    ViewData["Title"] = "Editar Servicio";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg" style="width: 450px; border-radius: 15px;">

        <div class="card-body p-4">

            <h3 class="text-center mb-4">Editar Servicio</h3>

            <form method="post">

                <input type="hidden" asp-for="IdServicio" />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Precio</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Servicio</label>

                    <select asp-for="IdTipoServicio" class="form-control">

                        <option value="">-- Seleccione un tipo --</option>

                        @foreach (var t in ViewBag.TipoServicios)
                        {
                            <option value="@t.IdTipoServicio">
                                @t.Nombre
                            </option>
                        }

                    </select>

                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Actualizar
                </button>

                <a href="/Servicio/Listar" class="btn btn-secondary w-100 mt-2">
                    Cancelar
                </a>

            </form>

        </div>
    </div>

</div>