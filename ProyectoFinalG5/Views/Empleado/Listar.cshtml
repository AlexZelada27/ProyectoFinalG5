@model List<ProyectoFinalG5.Models.Empleado>

<style>
    /* Título "Zone Style" en Rojo Oficial */
    .titulo {
        color: #dc3545;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    /* Tarjeta contenedora limpia */
    .card-empleados {
        background: #ffffff;
        border: 1px solid #d0dbe7;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 18, 56, 0.25);
        padding: 25px;
    }

    /* Cabecera de la tabla en Negro Elegante */
    .table thead th {
        background: #121212 !important;
        color: white;
        text-align: center;
        padding: 15px;
        border: none;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
        color: #2b2b2b;
    }

    /* Efecto hover suave en tono celeste/azul tenue */
    .table tbody tr:hover {
        background: #eef4fc;
        transition: .3s;
    }

    /* Botón Principal (Nuevo Empleado) en Azul Cápsula */
    .btn-purple {
        background: #0052d4;
        color: white;
        border-radius: 50px;
        padding: 10px 22px;
        text-decoration: none;
        font-weight: bold;
        box-shadow: 0 4px 12px rgba(0, 82, 212, 0.3);
        transition: all 0.25s ease;
        display: inline-block;
    }

        .btn-purple:hover {
            background: #003db0;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 61, 176, 0.4);
        }

    /* Botón Editar en Cápsula */
    .btn-editar {
        background: #ffc107;
        color: #212529;
        font-weight: bold;
        border-radius: 50px;
        padding: 7px 18px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .btn-editar:hover {
            background: #e0a800;
            color: #212529;
            transform: translateY(-1px);
        }

    /* Botón Eliminar en Cápsula */
    .btn-eliminar {
        background: #dc3545;
        color: white;
        font-weight: bold;
        border-radius: 50px;
        padding: 7px 18px;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .btn-eliminar:hover {
            background: #bb2d3b;
            color: white;
            transform: translateY(-1px);
        }

    .header-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
</style>

<div class="container mt-4">

    <div class="header-panel">

        <h2 class="titulo">
            🎤 Lista de Empleados
        </h2>


    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center shadow rounded-pill">
            @TempData["Error"]
        </div>
    }

    <div class="card card-empleados">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cargo</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Nombre</strong>
                        </td>

                        <td>
                            🎧 @item.Cargo
                        </td>

                        <td>
                            <a class="btn-editar me-1" href="/Empleado/Editar/@item.IdEmpleado">
                                ✏ Editar
                            </a>

                            <a class="btn-eliminar" href="/Empleado/Eliminar/@item.IdEmpleado"
                               onclick="return confirm('¿Deseas eliminar este empleado?');">
                                🗑 Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>