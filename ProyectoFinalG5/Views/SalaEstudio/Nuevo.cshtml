@model ProyectoFinalG5.Models.SalaEstudio

@{
    ViewData["Title"] = "Nueva Sala de Estudio";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg" style="width: 450px; border-radius: 15px;">

        <div class="card-body p-4">

            <h3 class="text-center mb-4">Nueva Sala de Estudio</h3>

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Sala A" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control" placeholder="Ej: Centro de estudios" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <textarea name="Descripcion" class="form-control"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Capacidad</label>
                    <input asp-for="Capacidad" type="number" class="form-control" placeholder="Ej: 20" />
                </div>


                <button type="submit" class="btn btn-success w-100">
                    Guardar
                </button>

            </form>

        </div>
    </div>

</div>