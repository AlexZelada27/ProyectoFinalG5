@model List<ProyectoFinalG5.Models.SalaEstudio>

@{
    ViewData["Title"] = "Salas de Estudio";
}

<style>
    /* Título "Zone Style" en Rojo Oficial */
    .titulo {
        color: #dc3545;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    /* Tarjeta contenedora limpia */
    .card-salas {
        background: #ffffff;
        border: 1px solid #d0dbe7;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 18, 56, 0.25);
        padding: 25px;
    }

    /* Botón Principal (+ Nueva Sala) en Azul Cápsula */
    .btn-purple {
        background: #0052d4;
        color: white;
        border-radius: 50px;
        padding: 10px 22px;
        text-decoration: none;
        font-weight: bold;
        box-shadow: 0 4px 12px rgba(0, 82, 212, 0.3);
        transition: all 0.25s ease;
        display: inline-block;
    }

        .btn-purple:hover {
            background: #003db0;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 61, 176, 0.4);
        }

    /* Cabecera de la tabla en Negro Elegante */
    .table thead th {
        background: #121212 !important;
        color: white;
        text-align: center;
        padding: 15px;
        border: none;
    }

    .table tbody td {
        vertical-align: middle;
        text-align: center;
        color: #2b2b2b;
    }

    /* Efecto hover suave en tono celeste/azul tenue */
    .table tbody tr:hover {
        background: #eef4fc;
        transition: .3s;
    }

    /* Botón Editar en Cápsula */
    .btn-editar {
        background: #ffc107;
        color: #212529;
        border-radius: 50px;
        padding: 7px 18px;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .btn-editar:hover {
            background: #e0a800;
            color: #212529;
            transform: translateY(-1px);
        }

    /* Botón Eliminar en Cápsula */
    .btn-eliminar {
        background: #dc3545;
        color: white;
        border-radius: 50px;
        padding: 7px 18px;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.2s ease;
        display: inline-block;
    }

        .btn-eliminar:hover {
            background: #bb2d3b;
            color: white;
            transform: translateY(-1px);
        }

    /* Badge de Capacidad en Azul Profesional Suave */
    .capacidad {
        background: #c1d7f0;
        color: #002878;
        padding: 8px 18px;
        border-radius: 50px;
        font-weight: 700;
        display: inline-block;
    }
</style>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h3 class="titulo">
            🎙 Salas de Estudio
        </h3>

        <a href="/SalaEstudio/Nuevo" class="btn-purple">
            + Nueva Sala
        </a>

    </div>

    <div class="card card-salas">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>Capacidad</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                🎧 <strong>@item.Nombre</strong>
                            </td>

                            <td>
                                📍 @item.Direccion
                            </td>

                            <td>
                                <span class="capacidad">
                                    👥 @item.Capacidad personas
                                </span>
                            </td>

                            <td>
                                <a href="/SalaEstudio/Editar/@item.IdSala" class="btn-editar me-1">
                                    ✏ Editar
                                </a>

                                <a href="/SalaEstudio/Eliminar/@item.IdSala" class="btn-eliminar"
                                   onclick="return confirm('¿Deseas eliminar esta sala?');">
                                    🗑 Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No hay salas registradas
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>