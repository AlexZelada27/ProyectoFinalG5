@{
    ViewData["Title"] = "Verificación de Administrador";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg p-4" style="width: 400px; border-radius: 15px;">

        <h3 class="text-center mb-4">Verificación de Administrador</h3>

        <form asp-action="VerificarAdmin" method="post">

            <div class="mb-3">
                <label class="form-label">Código de administrador</label>
                <input type="password" name="codigo" class="form-control" />
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center p-2">
                    @ViewBag.Error
                </div>
            }

            <button type="submit" class="btn btn-primary w-100">
                Validar
            </button>

        </form>

        <hr />

    </div>

</div>