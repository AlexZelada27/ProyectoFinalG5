@model ProyectoFinalG5.Models.Usuario

<h2 class="mb-4 text-danger">Eliminar Usuario</h2>

<div class="card shadow p-4">

    <h5>¿Estás seguro que deseas eliminar este usuario?</h5>

    <hr />

    <p><strong>Email:</strong> @Model.Email</p>

    <form method="post">
        <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

        <button type="submit" class="btn btn-danger">
            Eliminar
        </button>

        <a href="/Usuario/Listar" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>